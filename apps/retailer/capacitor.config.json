{
  "appId": "com.mittu.associatedretailer",
  "appName": "Mittu Associated Retailer",
  "webDir": "www",
  "server": {
    "url": "https://kiranabillgenerator.vercel.app/retailer/",
    "androidScheme": "https",
    "allowNavigation": [
      "kiranabillgenerator.vercel.app",
      "*.firebaseapp.com",
      "*.googleapis.com",
      "*.firebaseio.com",
      "*.gstatic.com",
      "cdnjs.cloudflare.com",
      "accounts.google.com",
      "*.google.com"
    ],
    "errorPath": "offline.html"
  },
  "backgroundColor": "#000000",
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    }
  }
}